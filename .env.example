# MongoDB Atlas connection string (replace username, password and cluster host)
# URL-encode special characters in the database user's password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ContentCreatorDB?retryWrites=true&w=majority

# Use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required only for the first creator account at /creator/setup.
# Remove this variable after creating the first account.
OWNER_SETUP_KEY=replace-with-a-long-one-time-setup-key

# Local API configuration
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000

# Optional frontend build variable: leave blank locally (Vite proxies /api and /uploads).
# For a separately hosted frontend, set this to the backend origin, e.g. https://api.example.com.
VITE_API_BASE_URL=
